  "excluded": [
    "Reynolds number and shock index: no existing lesson/question evidence found",
    "SV = contractility × preload: not a dimensionally defined numerical formula",
    "MAP = 60% systolic + 40% diastolic, and blood pressure = DBP + ½PP: replaced with lesson-supported MAP approximation"
  ],
  "clarified": [
    "Helium dilution gives FRC before subtracting ERV for RV",
    "Use oxygen content, not PaO2, for oxygen delivery",
    "Starling flow is transcapillary filtration, not a direct lymph-flow equation",
    "Simplified alveolar gas equation includes PaCO2/R",
    "PCO2 units determine whether the constant is 863 or 0.863"
  ],
